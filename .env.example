# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Numeric chat/channel id. Message the bot, then click Detect on the web page
# or run: python3 main.py chat-id
# For a channel, add the bot as admin and use an id like -1001234567890
TELEGRAM_CHAT_ID=

# Optional LLM for /best. Any OpenAI-compatible API works (OpenAI, OpenRouter, Groq).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
