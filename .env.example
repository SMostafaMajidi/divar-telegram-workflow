# Bot token from @BotFather — one shared bot for all customers
TELEGRAM_BOT_TOKEN=

# Optional Bale bot token (Telegram-compatible API). When set, Bale appears in the portal.
BALE_BOT_TOKEN=

# Eitaa: customers store their own Eitaayar token in the portal (per-user). No global token needed.


# Bale wallet payment provider token from @botfather (sendInvoice). Test: WALLET-TEST-1111111111111111
BALE_PAYMENT_PROVIDER_TOKEN=

# Admin panel login
ADMIN_USERNAME=mostafa
ADMIN_PASSWORD=1234

# Optional legacy token (Bearer / X-Admin-Token)
ADMIN_TOKEN=

# Public URL used in magic login links sent by the bot
PUBLIC_BASE_URL=https://est.rysh.ir

# Card-to-card payment (shown on invoices / pricing)
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=
PAYMENT_NOTE=
SUPPORT_TELEGRAM=

# Optional LLM for /best when ai_enabled is on for a customer
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
